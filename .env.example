PORT=9867
BASE_URL=http://localhost:9867

# Ziina configuration (optional - checkout works without it)
# Get your API token at https://ziina.com/business/connect
ZIINA_API_TOKEN=ziina_api_token_here
# Optional: secret used to sign/verify Ziina webhooks (X-Hmac-Signature)
ZIINA_WEBHOOK_SECRET=change-this-to-a-random-webhook-secret
# Optional: your public webhook URL, e.g. https://your-site.com/api/ziina-webhook (registered automatically on start)
ZIINA_WEBHOOK_URL=

# Twilio configuration (optional - SMS/WhatsApp notifications)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
NOTIFY_PHONE=+8613418092985

# JWT secret (generate a random string!)
JWT_SECRET=change-this-to-a-random-secret-string-in-production

# Admin credentials
ADMIN_EMAIL=admin@kickoff.com
ADMIN_PASSWORD=admin123
